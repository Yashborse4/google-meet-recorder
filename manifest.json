{
    "manifest_version": 3,
    "name": "Google Meet Transcript + Recorder",
    "version": "1.1.0",
    "permissions": ["activeTab", "downloads", "tabCapture", "offscreen", "storage", "tabs", "desktopCapture", "power"],
    "host_permissions": ["https://meet.google.com/*"],
    "action": { "default_popup": "popup.html" },
    "background": { "service_worker": "background.js", "type": "module" },
    "content_scripts": [
      { "matches": ["https://meet.google.com/*"], "js": ["scrapingScript.js"], "run_at": "document_idle" }
    ],
    "web_accessible_resources": [
      { "resources": ["offscreen.html", "micsetup.html"], "matches": ["<all_urls>"] }
    ],
    "commands": {
      "toggle-recording": {
        "suggested_key": {
          "default": "Alt+R",
          "mac": "Alt+R"
        },
        "description": "Toggle Google Meet recording"
      }
    }
  }
